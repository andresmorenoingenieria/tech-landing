---
import Icon from "./Icon.astro";

const plans = [
	{
		name: "Inicial",
		price: "0 €",
		period: "/mes",
		description: "Para empezar a experimentar con la plataforma.",
		features: [
			"Hasta 3 proyectos",
			"1,000 peticiones al mes",
			"Comunidad y documentación",
			"Soporte por correo",
		],
		cta: "Empieza gratis",
		highlight: false,
	},
	{
		name: "Profesional",
		price: "49 €",
		period: "/mes",
		description: "Para equipos que necesitan escala y automatización.",
		features: [
			"Proyectos ilimitados",
			"1M de peticiones al mes",
			"Nexora AI incluida",
			"Integraciones completas",
			"Soporte prioritario 24/7",
		],
		cta: "Probar 14 días",
		highlight: true,
	},
	{
		name: "Empresa",
		price: "A medida",
		period: "",
		description: "Para organizaciones con requisitos avanzados.",
		features: [
			"Acentos y límites personalizados",
			"SSO / SAML y auditoría",
			"Despliegue en tu infraestructura",
			"Gestor de cuenta dedicado",
			"SLA garantizado del 99.99%",
		],
		cta: "Hablar con ventas",
		highlight: false,
	},
];
---

<section id="precios" class="scroll-mt-20 bg-ink-50/50 py-20 sm:py-28">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<p class="text-sm font-semibold uppercase tracking-widest text-brand-600">
				Precios
			</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">
				Planes simples, sin sorpresas
			</h2>
			<p class="mt-4 text-base leading-relaxed text-ink-500 sm:text-lg">
				Empieza gratis y escala cuando lo necesites. Cancela cuando quieras.
			</p>
		</div>

		<div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
			{plans.map((plan) => (
				<div
					class:list={[
						"relative flex flex-col rounded-2xl border border-ink-100 bg-white p-8",
						plan.highlight
							? "border-brand-600 shadow-xl shadow-brand-100"
							: "transition-shadow hover:shadow-lg",
					]}
				>
					{plan.highlight && (
						<span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brand-600 px-3 py-1 text-xs font-semibold text-white">
							Más popular
						</span>
					)}
					<h3 class="text-lg font-semibold text-ink-900">{plan.name}</h3>
					<p class="mt-1 text-sm text-ink-500">{plan.description}</p>
					<p class="mt-6 flex items-baseline gap-1">
						<span class="text-4xl font-bold tracking-tight text-ink-900">
							{plan.price}
						</span>
						{plan.period && (
							<span class="text-sm font-medium text-ink-500">{plan.period}</span>
						)}
					</p>
					<ul class="mt-6 flex-1 space-y-3">
						{plan.features.map((feature) => (
							<li class="flex items-start gap-3 text-sm text-ink-700">
								<span
									class:list={[
										"mt-0.5 grid size-5 shrink-0 place-items-center rounded-full",
										plan.highlight ? "bg-brand-100 text-brand-600" : "bg-ink-100 text-ink-600",
									]}
								>
									<Icon name="check" class="size-3.5" />
								</span>
								{feature}
							</li>
						))}
					</ul>
					<a
						href="#contacto"
						class:list={[
							"mt-8 inline-flex w-full items-center justify-center rounded-lg px-4 py-2.5 text-sm font-semibold transition-colors",
							plan.highlight
								? "bg-brand-600 text-white hover:bg-brand-700"
								: "border border-ink-200 bg-white text-ink-900 hover:border-ink-300 hover:bg-ink-50",
						]}
					>
						{plan.cta}
					</a>
				</div>
			))}
		</div>

		<p class="mt-8 text-center text-sm text-ink-500">
			¿Necesitas algo a medida?{" "}
			<a href="#contacto" class="font-medium text-brand-600 underline-offset-4 hover:underline">
				Contacta con nuestro equipo
			</a>.
		</p>
	</div>
</section>