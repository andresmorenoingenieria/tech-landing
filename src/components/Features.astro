---
import Icon from "./Icon.astro";

const features = [
	{
		title: "Escalabilidad infinita",
		description:
			"Crece desde tu primer usuario hasta millones de peticiones diarias sin reconfigurar nada. La infraestructura se adapta sola.",
		icon: "scale",
	},
	{
		title: "Seguridad de nivel bancario",
		description:
			"Cifrado de extremo a extremo, cumplimiento ISO 27001 y control de accesos granular en cada capa de la plataforma.",
		icon: "shield",
	},
	{
		title: "Rendimiento ultrarrápido",
		description:
			"Entregas instantáneas en 30 ciudades del mundo con una arquitectura de borde optimizada al milisegundo.",
		icon: "bolt",
	},
	{
		title: "IA integrada",
		description:
			"Genera informes, automatiza tareas y obtén predicciones con Nexora AI, entrenada para trabajar con tus datos.",
		icon: "sparkles",
	},
	{
		title: "Integraciones ilimitadas",
		description:
			"Conecta tus herramientas favoritas con más de 200 integraciones nativas y una API REST documentada.",
		icon: "plug",
	},
	{
		title: "Soporte 24/7",
		description:
			"Un equipo de ingenieros a tu lado en todo momento, con tiempo medio de respuesta inferior a 5 minutos.",
		icon: "headset",
	},
];
---

<section id="beneficios" class="scroll-mt-20 py-20 sm:py-28">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<p class="text-sm font-semibold uppercase tracking-widest text-brand-600">
				Beneficios
			</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">
				Todo lo que tu empresa necesita, en una sola plataforma
			</h2>
			<p class="mt-4 text-base leading-relaxed text-ink-500 sm:text-lg">
				Deja de gestionar decenas de herramientas. Nexora unifica el stack
				tecnológico de tu negocio para que trabajes más rápido y con menos
				complejidad.
			</p>
		</div>

		<ul class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{features.map((feature) => (
				<li
					class="group rounded-2xl border border-ink-100 bg-white p-6 transition-all hover:-translate-y-1 hover:border-brand-200 hover:shadow-lg"
				>
					<div
						class="grid size-11 place-items-center rounded-xl bg-brand-50 text-brand-600 transition-colors group-hover:bg-brand-600 group-hover:text-white"
					>
						<Icon name={feature.icon} class="size-6" />
					</div>
					<h3 class="mt-5 text-lg font-semibold text-ink-900">
						{feature.title}
					</h3>
					<p class="mt-2 text-sm leading-relaxed text-ink-500">
						{feature.description}
					</p>
				</li>
			))}
		</ul>
	</div>
</section>