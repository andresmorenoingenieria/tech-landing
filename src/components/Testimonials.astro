---
import Icon from "./Icon.astro";

const testimonials = [
	{
		quote:
			"Nexora nos permitió reducir un 40% el tiempo de desarrollo de nuestros productos. El panel de análisis es, simplemente, otro nivel.",
		name: "María Fernández",
		role: "CTO · FinTech Albor",
		initials: "MF",
		color: "bg-brand-600",
	},
	{
		quote:
			"Migrar todo nuestro stack a Nexora nos llevó una tarde. La IA integrada nos ahorra horas todos los días. No volveríamos atrás.",
		name: "Jorge Ramírez",
		role: "Director de Producto · Solaris",
		initials: "JR",
		color: "bg-violet-600",
	},
	{
		quote:
			"El soporte responde en minutos y el rendimiento se mantiene estable incluso en nuestros picos de demanda más altos.",
		name: "Lucía Ortega",
		role: "Head of Engineering · KinetIQ",
		initials: "LO",
		color: "bg-emerald-600",
	},
];
---

<section class="py-20 sm:py-28">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<p class="text-sm font-semibold uppercase tracking-widest text-brand-600">
				Testimonios
			</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">
				Equipos reales, resultados reales
			</h2>
			<p class="mt-4 text-base leading-relaxed text-ink-500 sm:text-lg">
				Miles de empresas tecnológicas eligen Nexora cada año. Esto es lo que
				dicen de nosotros.
			</p>
		</div>

		<ul class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
			{testimonials.map((t) => (
				<li class="flex flex-col justify-between rounded-2xl border border-ink-100 bg-white p-6 transition-shadow hover:shadow-lg">
					<div>
						<Icon name="quote" class="size-8 text-brand-200" />
						<blockquote class="mt-4 text-base leading-relaxed text-ink-700">
							“{t.quote}”
						</blockquote>
					</div>
					<figcaption class="mt-6 flex items-center gap-3">
						<span
							class:list={[
								"grid size-11 place-items-center rounded-full text-sm font-semibold text-white",
								t.color,
							]}
							aria-hidden="true"
						>
							{t.initials}
						</span>
						<div>
							<p class="text-sm font-semibold text-ink-900">{t.name}</p>
							<p class="text-xs text-ink-500">{t.role}</p>
						</div>
					</figcaption>
				</li>
			))}
		</ul>
	</div>
</section>