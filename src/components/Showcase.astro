---
import Icon from "./Icon.astro";

const rows = [
	{
		kicker: "Análisis",
		title: "Toma decisiones con datos en tiempo real",
		description:
			"Paneles interactivos que convierten millones de datos en información clara. Visualiza métricas, detecta tendencias y actúa antes que tu competencia.",
		points: [
			"Paneles personalizables sin código",
			"Alertas inteligentes en tiempo real",
			"Exporta informes con un clic",
		],
		icon: "chart",
		visual: "chart",
	},
	{
		kicker: "Automatización",
		title: "Automatiza los procesos que te quitan horas",
		description:
			"Crea flujos de trabajo visuales que conectan tus aplicaciones. Nexora ejecuta las tareas repetitivas por ti, sin errores y a cualquier escala.",
		points: [
			"Editor visual de flujos drag & drop",
			"Disparadores en más de 200 apps",
			"Ejecución paralela sin límites",
		],
		icon: "bolt",
		visual: "workflow",
	},
	{
		kicker: "Seguridad",
		title: "Tus datos protegidos en todo momento",
		description:
			"Cifrado de extremo a extremo, auditorías continuas y cumplimiento normativo automático. Nexora está diseñada bajo los estándares más estrictos del sector.",
		points: [
			"Cifrado AES-256 en reposo y tránsito",
			"Cumplimiento ISO 27001 y SOC 2",
			"Copias de seguridad automáticas",
		],
		icon: "lock",
		visual: "lock",
	},
];

const chartBars = [38, 62, 45, 78, 55, 90, 72];
---

<section id="producto" class="scroll-mt-20 bg-ink-50/50 py-20 sm:py-28">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<p class="text-sm font-semibold uppercase tracking-widest text-brand-600">
				Producto
			</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">
				Una plataforma, infinitas posibilidades
			</h2>
			<p class="mt-4 text-base leading-relaxed text-ink-500 sm:text-lg">
				Explora las capacidades que hacen de Nexora la elección de los equipos
				más exigentes.
			</p>
		</div>

		<div class="mt-16 space-y-20">
			{rows.map((row, i) => (
				<div
					class:list={[
						"grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16",
						i % 2 === 1 && "lg:[&>*:first-child]:order-2",
					]}
				>
					<div>
						<span class="inline-flex items-center gap-2 rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-700">
							<Icon name={row.icon} class="size-4" />
							{row.kicker}
						</span>
						<h3 class="mt-4 text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">
							{row.title}
						</h3>
						<p class="mt-4 text-base leading-relaxed text-ink-500">
							{row.description}
						</p>
						<ul class="mt-6 space-y-3">
							{row.points.map((point) => (
								<li class="flex items-start gap-3 text-sm text-ink-700 sm:text-base">
									<span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-emerald-100 text-emerald-600">
										<Icon name="check" class="size-3.5" />
									</span>
									{point}
								</li>
							))}
						</ul>
					</div>

					<div
						class="rounded-2xl border border-ink-100 bg-white p-6 shadow-lg sm:p-8"
						aria-hidden="true"
					>
						{row.visual === "chart" && (
							<div>
								<div class="flex items-end justify-between gap-2">
									<p class="text-sm font-medium text-ink-500">Ingresos mensuales</p>
									<p class="text-xs font-medium text-emerald-600">+32% vs. trimestre anterior</p>
								</div>
								<div class="mt-6 flex h-48 items-end gap-3 sm:gap-4">
									{chartBars.map((h) => (
										<div
											class="flex-1 rounded-t-lg bg-gradient-to-t from-brand-600 to-violet-400"
											style={`height: ${h}%`}
										></div>
									))}
								</div>
								<div class="mt-3 flex gap-3 sm:gap-4" role="presentation">
									{["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"].map((d) => (
										<span class="flex-1 text-center text-xs text-ink-400">{d}</span>
									))}
								</div>
							</div>
						)}
						{row.visual === "workflow" && (
							<div class="space-y-4">
								{[1, 2, 3].map((n) => (
									<div class="flex items-center gap-4 rounded-xl border border-ink-100 bg-ink-50/50 p-4">
										<span class="grid size-9 shrink-0 place-items-center rounded-lg bg-brand-600 text-xs font-bold text-white">
											{n}
										</span>
										<div class="h-2.5 flex-1 rounded-full bg-ink-200"></div>
										<span class="h-2.5 w-20 rounded-full bg-ink-200 sm:w-28"></span>
									</div>
								))}
								<div class="rounded-xl border border-dashed border-brand-300 bg-brand-50 p-3 text-center text-xs font-medium text-brand-700">
									+ Añade nueva acción
								</div>
							</div>
						)}
						{row.visual === "lock" && (
							<div class="grid place-items-center py-6">
								<div class="relative">
									<div class="absolute inset-0 rounded-full bg-brand-200 blur-2xl" aria-hidden="true"></div>
									<div class="relative grid size-24 place-items-center rounded-full border border-brand-100 bg-brand-50 text-brand-600">
										<Icon name="lock" class="size-10" />
									</div>
								</div>
								<div class="mt-6 flex items-center gap-2 text-sm font-medium text-ink-700">
									<span class="size-2 rounded-full bg-emerald-500"></span>
									Cifrado activo · AES-256
								</div>
							</div>
						)}
					</div>
				</div>
			))}
		</div>
	</div>
</section>