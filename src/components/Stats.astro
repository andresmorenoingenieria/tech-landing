---
const stats = [
	{ value: "12k+", label: "Empresas activas" },
	{ value: "99.98%", label: "Uptime garantizado" },
	{ value: "140", label: "Países con soporte" },
	{ value: "4.9/5", label: "Valoración media" },
];
---

<section class="bg-brand-950 py-16 text-white sm:py-20">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
		<dl class="grid grid-cols-2 gap-8 lg:grid-cols-4">
			{stats.map((stat) => (
				<div class="text-center">
					<dt class="order-2 mt-2 block text-sm font-medium text-brand-200">
						{stat.label}
					</dt>
					<dd class="order-1 text-3xl font-bold tracking-tight sm:text-4xl">
						{stat.value}
					</dd>
				</div>
			))}
		</dl>
	</div>
</section>