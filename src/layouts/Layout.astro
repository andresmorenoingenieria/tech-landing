---
import "@fontsource-variable/inter";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Nexora — Plataforma tecnológica para empresas modernas",
	description =
		"La plataforma de tecnología que centraliza tus sistemas, datos e IA en un solo lugar. Escalable, segura y lista para tu negocio.",
} = Astro.props;

const canonicalURL = new URL("/", Astro.url);
const ogImage = new URL("/og-image.svg", Astro.url);
const meta = {
	url: canonicalURL,
	image: ogImage,
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={meta.url} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Nexora" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={meta.url} />
		<meta property="og:image" content={meta.image} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={meta.image} />

		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "Nexora",
			"description": description,
			"url": canonicalURL.href,
		})} />
	</head>
	<body>
		<slot />
	</body>
</html>